KURUMI_BOT_TOKEN=your_second_discord_bot_token_here

# Comma-separated Discord user IDs that get UNCONDITIONAL full access — every
# guild, every channel, including DMs — regardless of role. Use this for the
# human(s) who own the bot. Right-click your name in Discord (Developer Mode
# on) → Copy User ID.
KURUMI_OWNERS=

# Name of the Discord role whose members are allowed to invoke destructive
# MCP tools (create/edit/delete channels, roles, guild settings) inside the
# specific guild where they hold it. Anyone without this role (and not in
# KURUMI_OWNERS) gets chat-only access — the tools are not even attached to
# their session. Case-insensitive substring match (e.g. "✧ Founder" matches).
# Requires "Server Members Intent" enabled in the Discord Dev Portal.
# KURUMI_FOUNDER_ROLE=Founder

# Channels (and categories) whose name contains this substring make Kurumi
# auto-respond to every message — no @mention required. Case-insensitive.
# Default: "kurumi". Set empty to require @mention everywhere.
# KURUMI_ALWAYS_RESPOND_KEYWORD=kurumi

# Optional overrides (defaults set in compose.yml are fine for Docker use)
# KURUMI_WORKSPACE=/workspace
# KURUMI_SESSIONS_FILE=/state/sessions.json
# KURUMI_MODEL=claude-haiku-4-5
# CLAUDE_BIN=claude
# KURUMI_TIMEOUT_MS=300000
